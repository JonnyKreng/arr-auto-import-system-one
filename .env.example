# ─────────────────────────────────────────────────────────────────────────────
# ArrImportSystemOne — copy to .env and fill in, then: docker compose up -d --build
# The default COMPOSE_FILE below targets an AMD Radeon host. For macOS/local UI testing, see the
# optional compose.local.yaml section at the bottom.
# ─────────────────────────────────────────────────────────────────────────────

# General
TZ=Etc/UTC

# ── ArrImportSystemOne ──────────────────────────────────────────────────────
ARRIMPORT_IMAGE=arrimportsystemone:local
ARRIMPORT_HTTP_PORT=8080
ASPNETCORE_ENVIRONMENT=Production

# ── Existing Lidarr (NOT started by this compose file) ──────────────────────
# Docker Desktop (macOS/Windows) or Docker on Linux with the host-gateway mapping:
#   http://host.docker.internal:8686
# Lidarr in another container / on the LAN:
#   http://<lidarr-host-or-container>:8686
LIDARR_URL=http://host.docker.internal:8686

# Lidarr → Settings → General → API Key (or the value set via LIDARR__AUTH__APIKEY).
LIDARR_API_KEY=your-lidarr-api-key

# true = decide and show in the UI but do not import or reject.
LIDARR_DRY_RUN=true
LIDARR_POLL_INTERVAL_SECONDS=60

# ── System One decision provider (current provider: Mica) ───────────────────
# Target Radeon/AMD GPUs use compose.vulkan.yaml, which includes the app from compose.yaml and
# replaces the CUDA provider with the Vulkan build. On an NVIDIA host, use compose.yaml on its own.
COMPOSE_FILE=compose.vulkan.yaml

# Compose builds the current provider from this pinned Mica commit on first use.
# SYSTEMONE_BUILD_CONTEXT is used by the CUDA image in compose.yaml. The Vulkan image clones
# SYSTEMONE_MICA_COMMIT directly and builds llama.cpp at SYSTEMONE_LLAMA_TAG.
# Use #main for the latest upstream source, or a local checkout:
#   SYSTEMONE_BUILD_CONTEXT=../Mica
# To use a prebuilt image instead, set SYSTEMONE_IMAGE and run without --build.
SYSTEMONE_IMAGE=arrimportsystemone-systemone:local
SYSTEMONE_BUILD_CONTEXT=https://github.com/akivet/Mica.git#a21c3cecefba92b11ee65b53f9241e252752eb52
SYSTEMONE_MICA_COMMIT=a21c3cecefba92b11ee65b53f9241e252752eb52
SYSTEMONE_LLAMA_TAG=b11700

# CUDA architectures to compile for. Mica's default covers:
#   86 = RTX 30xx / A6000, 89 = RTX 40xx / L40S, 90 = H100 / H200
# Add another architecture (for example 120 for RTX 50xx) if needed.
SYSTEMONE_CUDA_ARCH=86;89;90

# Host port is for manual /health checks; the app reaches the provider over the Compose network.
SYSTEMONE_HOST_PORT=8010
SYSTEMONE_CONTAINER_PORT=8010

# "all" = every NVIDIA GPU, or a number such as 1.
SYSTEMONE_GPU_COUNT=all

# Mica model settings (mapped to the upstream MICA_* variables in compose.yaml).
SYSTEMONE_MODEL=mica-v0.5-4b-Q8_0.gguf
SYSTEMONE_MODEL_REPO=sky7350/Mica-v0.5-4B
SYSTEMONE_MODEL_REVISION=main
SYSTEMONE_MODEL_NAME=mica-v0.5-4b

# ── Vulkan provider (AMD Radeon, 12 GB) ────────────────────────────────────
# Used by compose.vulkan.yaml. The container needs /dev/dri from the Radeon host.
SYSTEMONE_VULKAN_IMAGE=arrimportsystemone-systemone-vulkan:local
# Q8_0 + one 32k sequence fits a 12 GB Radeon (the app has a single worker, so one sequence is
# enough). If Vulkan reports out-of-memory, switch to mica-v0.5-4b-IQ4_XS.gguf or lower
# SYSTEMONE_VULKAN_N_CTX.
SYSTEMONE_VULKAN_N_CTX=32768
SYSTEMONE_VULKAN_SEQS=1
SYSTEMONE_VULKAN_STATE_CACHE=off
SYSTEMONE_VULKAN_N_UBATCH=256

# ── System One client ───────────────────────────────────────────────────────
# The app talks to the provider through the provider-neutral SystemOne client. To switch
# providers later, change the client registration; the pipeline and these settings stay the same.
SYSTEMONE_TIMEOUT_SECONDS=120
# Probe /health at this interval. While unhealthy the worker pauses and retries downloads.
SYSTEMONE_HEALTH_CHECK_SECONDS=15
# Below this confidence the file is left to a human. 0.75 is the design default.
MODEL_MIN_CONFIDENCE=0.75

# ── Optional: local UI/plumbing demo without a GPU (for example macOS) ─────
# Docker Desktop on macOS cannot pass the Mac GPU into a Linux container, so Vulkan cannot be
# tested there. compose.local.yaml includes the app service from compose.yaml and replaces Mica
# with a small protocol stub. It is NOT a decision model; keep LIDARR_DRY_RUN=true.
# COMPOSE_FILE=compose.local.yaml
# SYSTEMONE_LOCAL_IMAGE=python:3.12-alpine

# ── Optional: real Mica model on CPU (slow) ────────────────────────────────
# Runs the Vulkan image without /dev/dri; llama.cpp falls back to CPU. Useful for a local
# health/protocol smoke test only. Use compose.local.yaml for fast end-to-end UI testing.
# COMPOSE_FILE=compose.local-model.yaml
SYSTEMONE_LOCAL_MODEL_N_CTX=4096
SYSTEMONE_LOCAL_MODEL_SEQS=1
SYSTEMONE_LOCAL_MODEL_N_UBATCH=256
